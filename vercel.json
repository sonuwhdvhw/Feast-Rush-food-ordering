{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ],
  "routes": [
    { "src": "/", "dest": "/index.html" },
    { "src": "/restaurants", "dest": "/restaurants.html" },
    { "src": "/menu", "dest": "/menu.html" },
    { "src": "/cart", "dest": "/cart.html" },
    { "src": "/auth", "dest": "/auth.html" },
    { "src": "/admin", "dest": "/admin.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
